# انسخ هذا الملف باسم .env.local (محلياً) وعبّي القيم.
# على Vercel: حط نفس المتغيرات في Settings → Environment Variables

# ===== Supabase (تسجيل الدخول والمزامنة) =====
# Project Settings → API. هذي مفاتيح عامة ومسموح توصل للمتصفح (RLS يحمي البيانات)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# مفتاح سري (service_role أو secret). للسيرفر فقط: التقرير التلقائي. لا تحطه أبداً في متغير يبدأ بـ NEXT_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=

# رمز التحقق على الإيميل عند كل تسجيل دخول (false = إيقاف مؤقت)
NEXT_PUBLIC_REQUIRE_EMAIL_CODE=true

# ===== Gemini (قراءة الملصق + جملة التشجيع) — مجاني من aistudio.google.com =====
GEMINI_API_KEY=
# اختياري: الموديل (الافتراضي gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
# اختياري: موديلات احتياطية لو الأساسي مشغول (ضغط عالي أو حد الطلبات)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
# اختياري: موديلات سريعة للمهام القصيرة (تقدير السعرات السريعة وجملة التشجيع)
GEMINI_FAST_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest

# ===== الإيميل عن طريق Resend =====
RESEND_API_KEY=
# بدون دومين خاص: onboarding@resend.dev (يرسل بس لإيميلك اللي سجلت فيه في Resend)
RESEND_FROM=Lyaqa <onboarding@resend.dev>

# ===== واتساب (WhatsApp Cloud API من Meta) =====
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=daily_report
# اختياري: لغة القالب (الافتراضي حسب لغة التطبيق: ar أو en)
WHATSAPP_TEMPLATE_LANG=ar
WHATSAPP_API_VERSION=v23.0

# ===== التقرير التلقائي (Vercel Cron) =====
# أي نص عشوائي طويل. Vercel يرسله مع طلب الـ Cron عشان محد غيره يشغل الرابط
CRON_SECRET=
# كم دقيقة قبل وقت التقرير مسموح يرسل (Vercel المجاني يشغل المهمة بأي دقيقة داخل الساعة)
REPORT_TOLERANCE_MINUTES=60
# كم تقرير بكل تشغيل ياخذ جملة تشجيع من Gemini (الباقي جملة جاهزة)
REPORT_AI_LIMIT=15
# اختياري: رابط التطبيق (يظهر زر "افتح التطبيق" في الإيميل)
APP_URL=
